# Copy to deploy/config (untracked) and fill in. The deploy scripts read it.
#
# The public hostname, served by the edge; deploy.sh fills it into the
# systemd unit as the allowed Host header.
WHATSAPP_DOMAIN=whatsapp.example.com
# The server's address on the private network: the service listens there and
# the deploy scripts ssh to it (through the edge).
WHATSAPP_PRIVATE_IP=10.0.0.2
# Optional: a different ssh target.
# WHATSAPP_HOST=root@10.0.0.2
